{
 "doctype": "DocType", "name": "DGI Tax Group", "module": "DGI Compliance",
 "custom": 0, "engine": "InnoDB", "autoname": "field:code", "track_changes": 1,
 "title_field": "description",
 "fields": [
  {"fieldname": "code", "label": "Code (A-Z)", "fieldtype": "Data", "unique": 1, "reqd": 1, "in_list_view": 1, "description": "Groupe de taxation (FACNO v2.0) : A a S applicables, T a Z reserves."},
  {"fieldname": "description", "label": "Description", "fieldtype": "Data", "in_list_view": 1},
  {"fieldname": "rate", "label": "Taux (%)", "fieldtype": "Float", "precision": "4", "in_list_view": 1, "description": "Renseigne par /api/info/taxGroups."},
  {"fieldname": "is_vat", "label": "Soumis a TVA", "fieldtype": "Check", "default": "0"},
  {"fieldname": "is_active", "label": "Actif", "fieldtype": "Check", "default": "1", "in_list_view": 1, "description": "Un groupe reserve (T a Z) ne peut pas etre active : aucun article ne peut y etre enregistre."},
  {"fieldname": "is_reserved", "label": "Reserve (DGI)", "fieldtype": "Check", "default": "0", "read_only": 1, "in_list_view": 1, "description": "Groupes T a Z : reserves par la DGI pour des evolutions futures (Reserve 1 a 7)."},
  {"fieldname": "cb_1", "fieldtype": "Column Break"},
  {"fieldname": "source", "label": "Source", "fieldtype": "Select", "options": "Static\nAPI\nManual", "default": "Static", "in_list_view": 1},
  {"fieldname": "manual_override", "label": "Verrouiller (override manuel)", "fieldtype": "Check", "default": "0"},
  {"fieldname": "last_synced", "label": "Derniere synchro", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "sync_status", "label": "Statut synchro", "fieldtype": "Data", "read_only": 1},
  {"fieldname": "sb_notes", "label": "Notes", "fieldtype": "Section Break"},
  {"fieldname": "notes", "label": "Notes", "fieldtype": "Small Text"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Accounts Manager", "read": 1, "write": 1},
  {"role": "Accounts User", "read": 1}
 ]
}

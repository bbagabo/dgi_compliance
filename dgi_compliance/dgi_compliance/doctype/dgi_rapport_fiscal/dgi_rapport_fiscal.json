{
 "doctype": "DocType",
 "name": "DGI Rapport Fiscal",
 "module": "DGI Compliance",
 "custom": 0,
 "engine": "InnoDB",
 "track_changes": 0,
 "sort_field": "creation",
 "sort_order": "DESC",
 "title_field": "report_title",
 "description": "Rapports statistiques X (quotidien / periodique), Z et A (SFE 1.3 et 1.4). Chaque rapport est fige a sa generation et conserve dans le journal electronique.",
 "search_fields": "report_type,company",
 "fields": [
  {
   "fieldname": "report_type",
   "label": "Type de rapport",
   "fieldtype": "Select",
   "options": "X quotidien\nX périodique\nZ\nA",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "set_only_once": 1,
   "default": "X quotidien"
  },
  {
   "fieldname": "company",
   "label": "Societe",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "in_standard_filter": 1,
   "set_only_once": 1,
   "remember_last_selected_value": 1
  },
  {
   "fieldname": "sequence_no",
   "label": "Numero",
   "fieldtype": "Int",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "report_title",
   "label": "Titre",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "cb_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "from_datetime",
   "label": "Debut de periode",
   "fieldtype": "Datetime",
   "in_list_view": 1,
   "depends_on": "eval:doc.report_type=='X périodique' || !doc.__islocal",
   "mandatory_depends_on": "eval:doc.report_type=='X périodique'",
   "set_only_once": 1,
   "description": "Saisie uniquement pour un rapport X periodique. Pour Z et X quotidien: depuis le dernier rapport Z; pour A: depuis le dernier rapport A."
  },
  {
   "fieldname": "to_datetime",
   "label": "Fin de periode",
   "fieldtype": "Datetime",
   "in_list_view": 1,
   "depends_on": "eval:doc.report_type=='X périodique' || !doc.__islocal",
   "set_only_once": 1
  },
  {
   "fieldname": "sb_snap",
   "fieldtype": "Section Break",
   "label": "Identification",
   "depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "company_name",
   "label": "Denomination",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "nif",
   "label": "NIF",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "isf",
   "label": "ISF",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "cb_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "generated_on",
   "label": "Date et heure du rapport",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "generated_by",
   "label": "Genere par",
   "fieldtype": "Link",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "sb_sum",
   "fieldtype": "Section Break",
   "label": "Synthese (CDF)",
   "depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "invoice_count",
   "label": "Nombre de factures / articles",
   "fieldtype": "Int",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "incomplete_count",
   "label": "Ventes incompletes",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "cb_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_ttc",
   "label": "Total net TTC",
   "fieldtype": "Currency",
   "options": "",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "total_vat",
   "label": "TVA nette",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "sb_data",
   "fieldtype": "Section Break",
   "label": "Donnees",
   "collapsible": 1
  },
  {
   "fieldname": "report_data",
   "label": "Donnees du rapport (JSON)",
   "fieldtype": "Long Text",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "create": 1,
   "print": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "create": 1,
   "print": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Accounts User",
   "read": 1,
   "create": 1,
   "print": 1,
   "report": 1
  }
 ]
}

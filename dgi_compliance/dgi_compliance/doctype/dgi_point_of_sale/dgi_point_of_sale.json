{
 "doctype": "DocType",
 "name": "DGI Point of Sale",
 "module": "DGI Compliance",
 "custom": 0,
 "engine": "InnoDB",
 "autoname": "field:pos_name",
 "track_changes": 1,
 "title_field": "pos_name",
 "fields": [
  {
   "fieldname": "pos_name",
   "label": "Point de vente",
   "fieldtype": "Data",
   "unique": 1,
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "label": "Societe",
   "fieldtype": "Link",
   "options": "Company",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Societe (NIF) qui emet les factures de ce point de vente. Obligatoire des qu'il y a plusieurs societes."
  },
  {
   "fieldname": "branch",
   "label": "Branche / site",
   "fieldtype": "Link",
   "options": "Branch",
   "description": "Une agence ne designe qu'un point de vente actif par societe."
  },
  {
   "fieldname": "nim",
   "label": "NIM (e-MCF)",
   "fieldtype": "Link",
   "options": "DGI EMCF",
   "in_list_view": 1,
   "description": "e-MCF rattache (synchronise depuis /api/info/status)."
  },
  {
   "fieldname": "is_sales_location",
   "label": "Sales Location (lieu de vente)",
   "fieldtype": "Check",
   "default": "1",
   "in_list_view": 1,
   "description": "Matrice A: si coche, NID et Token deviennent obligatoires."
  },
  {
   "fieldname": "is_active",
   "label": "Actif",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "cb_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "nid",
   "label": "Identifiant imprime declare (Matrice A)",
   "fieldtype": "Data",
   "description": "Champ herite de la Matrice A. Il ne sert pas au routage : le NIM est dans 'NIM (e-MCF)', le NID du MCF dans 'MCF rattache'."
  },
  {
   "fieldname": "token",
   "label": "Token e-DEF (override)",
   "fieldtype": "Password",
   "description": "Jeton JWT de l'e-MCF de ce point de vente (un jeton = un e-MCF). Prioritaire sur le jeton global depuis HL2."
  },
  {
   "fieldname": "token_check",
   "fieldtype": "Select",
   "label": "Controle du jeton",
   "options": "\nNon verifie\nOK\nDifferent\nErreur",
   "read_only": 1,
   "description": "Resultat de 'Tester le jeton e-MCF' : le NIM renvoye par la DGI pour ce jeton doit etre celui du point de vente."
  },
  {
   "fieldname": "token_nim",
   "fieldtype": "Data",
   "label": "NIM renvoye pour ce jeton",
   "read_only": 1
  },
  {
   "fieldname": "token_checked_on",
   "fieldtype": "Datetime",
   "label": "Jeton controle le",
   "read_only": 1
  },
  {
   "fieldname": "nid_requirement",
   "label": "NID requis",
   "fieldtype": "Select",
   "options": "Optional\nMandatory",
   "default": "Mandatory",
   "description": "Calcule depuis la Matrice A selon 'Sales Location'; modifiable."
  },
  {
   "fieldname": "token_requirement",
   "label": "Token requis",
   "fieldtype": "Select",
   "options": "Optional\nMandatory",
   "default": "Mandatory"
  },
  {
   "fieldname": "sb_channel",
   "label": "Canal de normalisation (HL2)",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "primary_channel",
   "label": "Canal prioritaire (derogation)",
   "fieldtype": "Select",
   "options": "\ne-MCF\nMCF",
   "description": "Vide : canal prioritaire de DGI Compliance Settings. Renseigne : derogation pour ce point de vente (DGI Fiscal Manager ou System Manager, motif obligatoire)."
  },
  {
   "fieldname": "priority_reason",
   "fieldtype": "Small Text",
   "label": "Motif de la derogation",
   "depends_on": "primary_channel",
   "mandatory_depends_on": "primary_channel"
  },
  {
   "fieldname": "active_channel",
   "label": "Canal en vigueur",
   "fieldtype": "Select",
   "options": "\ne-MCF\nMCF",
   "read_only": 1,
   "bold": 1,
   "in_list_view": 1,
   "description": "Calcule : canal prioritaire, ou canal impose par une bascule manuelle en vigueur. Le secours automatique, s'il est ouvert, est indique a part."
  },
  {
   "fieldname": "forced_switch",
   "fieldtype": "Link",
   "label": "Bascule manuelle en vigueur",
   "options": "DGI Channel Switch",
   "read_only": 1
  },
  {
   "fieldname": "mcf_device",
   "label": "MCF rattache (NID)",
   "fieldtype": "Link",
   "options": "DGI MCF Device"
  },
  {
   "fieldname": "fallback_policy",
   "fieldtype": "Select",
   "label": "Secours automatique sur l'autre canal",
   "options": "Automatique\nManuelle\nAucune",
   "default": "Automatique",
   "description": "Automatique : l'autre canal prend le relais seulement quand le canal prioritaire n'a certainement pas recu la facture, dans les deux sens. Manuelle : les factures attendent, alerte. Aucune : jamais l'autre canal."
  },
  {
   "fieldname": "cb_channel",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "switch_allowed",
   "label": "Bascule manuelle autorisee",
   "fieldtype": "Check",
   "default": "1",
   "description": "A cocher seulement apres confirmation ecrite de la DGI (cohabitation e-MCF / MCF pour ce point de vente)."
  },
  {
   "fieldname": "dgi_switch_reference",
   "label": "Reference de l'accord DGI",
   "fieldtype": "Data",
   "depends_on": "switch_allowed"
  },
  {
   "fieldname": "fallback_since",
   "fieldtype": "Datetime",
   "label": "Secours MCF actif depuis",
   "read_only": 1
  },
  {
   "fieldname": "fallback_reason",
   "fieldtype": "Small Text",
   "label": "Cause du secours",
   "read_only": 1
  },
  {
   "fieldname": "sb_addr",
   "fieldtype": "Section Break",
   "label": "Adresse imprimee sur la facture",
   "description": "Par defaut, l'adresse du point de vente vient de l'e-MCF (DGI EMCF, synchronise). Ces champs la remplacent s'ils sont renseignes."
  },
  {
   "fieldname": "pos_code",
   "fieldtype": "Data",
   "label": "Code magasin"
  },
  {
   "fieldname": "pos_address",
   "fieldtype": "Small Text",
   "label": "Adresse"
  },
  {
   "fieldname": "cb_addr",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "pos_city",
   "fieldtype": "Data",
   "label": "Ville"
  },
  {
   "fieldname": "pos_phone",
   "fieldtype": "Data",
   "label": "Telephone"
  },
  {
   "fieldname": "pos_terminal",
   "fieldtype": "Data",
   "label": "Terminal / caisse"
  },
  {
   "fieldname": "sb_api",
   "label": "Statut & Synchro",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "api_status",
   "label": "Statut e-MCF",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "last_synced",
   "label": "Derniere synchro",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "cb_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "sync_status",
   "label": "Statut synchro",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "source",
   "label": "Source",
   "fieldtype": "Select",
   "options": "Manual\nAPI",
   "default": "Manual"
  },
  {
   "fieldname": "sb_notes",
   "label": "Notes",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "notes",
   "label": "Notes",
   "fieldtype": "Small Text"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "write": 1
  },
  {
   "role": "Accounts User",
   "read": 1
  },
  {
   "role": "DGI Fiscal Manager",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "DGI Caisse MCF",
   "read": 1
  }
 ]
}
